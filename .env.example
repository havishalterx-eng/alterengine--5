# Copy to .env in YOUR worktree. Never commit .env.
#
# Each agent gets its own database on the shared Postgres instance.
# Four builders running tests against one database truncate each other's
# tables, and the resulting failures look exactly like real bugs.

ALTER_RUNTIME_MODE=development

# Set DATABASE_URL to YOUR line, not someone else's:
#   Builder A     postgresql://alter:alter_local_dev@localhost:5440/alter_builder_a
#   Builder B     postgresql://alter:alter_local_dev@localhost:5440/alter_builder_b
#   Builder C     postgresql://alter:alter_local_dev@localhost:5440/alter_builder_c
#   Integrator    postgresql://alter:alter_local_dev@localhost:5440/alter_integrator
#   CEO / main    postgresql://alter:alter_local_dev@localhost:5440/alter
DATABASE_URL=postgresql://alter:alter_local_dev@localhost:5440/alter

REDIS_URL=redis://localhost:6390
TEMPORAL_ADDRESS=localhost:7240

# Redis is shared. Namespace every key with your agent name so four
# builders do not overwrite each other: alter:builder_a:<key>
REDIS_KEY_PREFIX=alter:ceo
